  <style>
    :root {
      --marker-red: #d71920;
      --marker-shadow: rgba(35, 22, 20, 0.22);
      --vh: 1vh;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      width: 100%;
      min-height: 100%;
      margin: 0;
    }

    body {
      min-height: calc(100 * min(var(--vh, 1vh), 1vh));
      overflow: hidden;
      font-family: "DM Sans", sans-serif;
      background-color: #f3eee8;
      background-position: center;
      background-repeat: no-repeat;
      background-size: cover;
    }

    .board-stage {
      width: 100%;
      min-height: calc(100 * min(var(--vh, 1vh), 1vh));
      position: relative;
      overflow: hidden;
      isolation: isolate;
      background-color: transparent;
      padding: clamp(1rem, 3vw, 3.5rem);
      touch-action: none;
    }

    .board-stage::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background: rgba(255, 255, 255, 0.04);
      pointer-events: none;
    }

    .marker {
      position: absolute;
      width: clamp(90px, 13vw, 190px);
      aspect-ratio: 1 / 1.18;
      padding: 0;
      border: 0;
      background: transparent;
      filter: drop-shadow(0 12px 12px var(--marker-shadow));
      animation: settle-in 620ms cubic-bezier(.2, .8, .2, 1) both;
      cursor: grab;
      touch-action: none;
      user-select: none;
      will-change: transform;
    }

    .marker:focus-visible {
      outline: 4px solid #1c1917;
      outline-offset: 7px;
      border-radius: 50%;
    }

    .marker.is-dragging {
      cursor: grabbing;
      animation: none;
      z-index: 50;
    }

    .marker::after {
      content: "";
      position: absolute;
      z-index: -1;
      width: 38%;
      aspect-ratio: 1;
      left: 50%;
      bottom: 1.8%;
      transform: translateX(-50%) rotate(45deg);
      background: var(--marker-red);
      border-right: 3px solid var(--marker-red);
      border-bottom: 3px solid var(--marker-red);
    }

    .marker-frame {
      width: 100%;
      aspect-ratio: 1;
      overflow: hidden;
      border: 3px solid var(--marker-red);
      border-radius: 50%;
      background: #fff7ed;
      position: relative;
      z-index: 1;
    }

    .marker-frame img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      border-radius: 50%;
      transition: transform 300ms ease;
    }

    .marker-label {
      position: absolute;
      z-index: 3;
      left: 50%;
      bottom: 12%;
      transform: translateX(-50%);
      width: 88%;
      margin: 0;
      padding: 0.2rem 0.35rem;
      border-radius: 0.3rem;
      background: rgba(28, 25, 23, 0.88);
      color: #ffffff;
      font-size: clamp(0.58rem, 1.15vw, 0.82rem);
      font-weight: 700;
      line-height: 1.1;
      text-align: center;
      text-wrap: balance;
      pointer-events: none;
    }

    .marker:hover .marker-frame img,
    .marker:focus-visible .marker-frame img {
      transform: scale(1.06);
    }

    .marker-a { left: 7%; top: 9%; transform: rotate(-8deg); animation-delay: 60ms; }
    .marker-b { left: 28%; top: 10%; transform: rotate(6deg); animation-delay: 120ms; }
    .marker-c { right: 23%; top: 7%; transform: rotate(-4deg); animation-delay: 180ms; }
    .marker-d { right: 6%; top: 19%; transform: rotate(8deg); animation-delay: 240ms; }
    .marker-e { left: 13%; bottom: 7%; transform: rotate(5deg); animation-delay: 300ms; }
    .marker-f { left: 44%; bottom: 5%; transform: rotate(-7deg); animation-delay: 360ms; }
    .marker-g { right: 8%; bottom: 7%; transform: rotate(5deg); animation-delay: 420ms; }

    @keyframes settle-in {
      from {
        opacity: 0;
        scale: 0.72;
      }
      to {
        opacity: 1;
        scale: 1;
      }
    }

    @media (max-width: 700px) {
      body {
        overflow-y: auto;
      }

      .board-stage {
        min-height: calc(100 * min(var(--vh, 1vh), 1vh));
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        align-content: center;
        gap: 1.7rem 1.2rem;
        padding: 2rem 1.5rem 3rem;
        touch-action: pan-y;
      }

      .marker {
        width: min(36vw, 155px);
        position: relative;
        inset: auto;
        justify-self: center;
      }

      .marker.is-dragging {
        position: absolute;
      }

      .marker-a { transform: rotate(-7deg); }
      .marker-b { transform: rotate(6deg); }
      .marker-c { transform: rotate(-4deg); }
      .marker-d { transform: rotate(7deg); }
      .marker-e { transform: rotate(4deg); }
      .marker-f { transform: rotate(-6deg); }

      .marker-g {
        transform: rotate(5deg);
        grid-column: 1 / -1;
      }
    }
