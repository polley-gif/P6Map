  <script>
    (() => {
      const setViewportHeight = () => {
        document.documentElement.style.setProperty("--vh", `${window.innerHeight * 0.01}px`);
      };

      setViewportHeight();
      window.addEventListener("resize", setViewportHeight);

      const stage = document.querySelector(".board-stage");
      const markers = document.querySelectorAll(".marker");
      let active = null;
      let framePending = false;
      let latestEvent = null;

      function stopInteraction(event) {
        if (!active) return;
        if (event && event.pointerId !== undefined && active.pointerId !== event.pointerId) return;

        if (active.raf) cancelAnimationFrame(active.raf);

        const marker = active.marker;
        marker.classList.remove("is-dragging");

        if (window.innerWidth <= 700) {
          marker.style.left = "";
          marker.style.top = "";
          marker.style.right = "";
          marker.style.bottom = "";
        }

        active = null;
        latestEvent = null;
        framePending = false;
      }

      function moveMarker(marker, left, top) {
        const stageRect = stage.getBoundingClientRect();
        const markerWidth = marker.offsetWidth;
        const markerHeight = marker.offsetHeight;
        const boundedLeft = Math.max(0, Math.min(stageRect.width - markerWidth, left));
        const boundedTop = Math.max(0, Math.min(stageRect.height - markerHeight, top));

        marker.style.left = `${boundedLeft}px`;
        marker.style.top = `${boundedTop}px`;
        marker.style.right = "auto";
        marker.style.bottom = "auto";
      }

      markers.forEach((marker) => {
        marker.addEventListener("pointerdown", (event) => {
          if (event.button !== 0) return;

          event.preventDefault();

          const rect = marker.getBoundingClientRect();
          const stageRect = stage.getBoundingClientRect();

          active = {
            marker,
            pointerId: event.pointerId,
            startX: event.clientX,
            startY: event.clientY,
            startLeft: rect.left - stageRect.left,
            startTop: rect.top - stageRect.top,
            markerWidth: marker.offsetWidth,
            markerHeight: marker.offsetHeight,
            stageWidth: stageRect.width,
            stageHeight: stage.clientHeight,
            raf: null
          };

          marker.style.left = `${active.startLeft}px`;
          marker.style.top = `${active.startTop}px`;
          marker.style.right = "auto";
          marker.style.bottom = "auto";
          marker.classList.add("is-dragging");
          marker.setPointerCapture(event.pointerId);
        });

        marker.addEventListener("pointermove", (event) => {
          if (!active || active.marker !== marker || active.pointerId !== event.pointerId) return;

          latestEvent = event;

          if (framePending) return;
          framePending = true;

          active.raf = requestAnimationFrame(() => {
            if (!active || !latestEvent) {
              framePending = false;
              return;
            }

            const dx = latestEvent.clientX - active.startX;
            const dy = latestEvent.clientY - active.startY;

            moveMarker(marker, active.startLeft + dx, active.startTop + dy);
            framePending = false;
          });
        });

        marker.addEventListener("pointerup", stopInteraction);
        marker.addEventListener("pointercancel", stopInteraction);
        marker.addEventListener("lostpointercapture", stopInteraction);

        marker.addEventListener("keydown", (event) => {
          if (window.innerWidth <= 700) return;

          const directions = {
            ArrowLeft: [-12, 0],
            ArrowRight: [12, 0],
            ArrowUp: [0, -12],
            ArrowDown: [0, 12]
          };

          if (!directions[event.key]) return;

          event.preventDefault();

          const markerRect = marker.getBoundingClientRect();
          const stageRect = stage.getBoundingClientRect();
          const [xStep, yStep] = directions[event.key];

          moveMarker(
            marker,
            markerRect.left - stageRect.left + xStep,
            markerRect.top - stageRect.top + yStep
          );
        });
      });

      window.addEventListener("pointerup", stopInteraction, true);
      window.addEventListener("pointercancel", stopInteraction, true);
    })();
  </script>
 
